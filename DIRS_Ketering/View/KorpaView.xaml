<UserControl x:Class="DIRS_Ketering.View.KorpaView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:DIRS_Ketering.View"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DataGrid Grid.Row="0"
              ItemsSource="{Binding Stavke}"
              SelectedItem="{Binding SelektovanaStavka}"
              AutoGenerateColumns="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Naziv" Binding="{Binding Naziv}" Width="*" IsReadOnly="True"/>
                <DataGridTextColumn Header="Cena" Binding="{Binding Cena}" Width="100" IsReadOnly="True"/>
                <DataGridTextColumn Header="Količina" Binding="{Binding Kolicina}" Width="100"/>
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock Grid.Row="1" Text="{Binding Ukupno, StringFormat='Ukupno: {0} RSD'}" FontSize="16" Margin="0,10"/>

        <TextBlock Grid.Row="2" Text="Adresa isporuke" Margin="0,4"/>
        <TextBox Grid.Row="3" Text="{Binding AdresaIsporuke, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10"/>

        <TextBlock Grid.Row="4" Text="Datum isporuke" Margin="0,4"/>
        <DatePicker Grid.Row="5" SelectedDate="{Binding DatumIsporuke}" Margin="0,0,0,10"/>

        <StackPanel Grid.Row="6" Orientation="Horizontal">
            <Button Content="Ukloni stavku" Command="{Binding ObrisiCommand}" Margin="0,0,10,0"/>
            <Button Content="Potvrdi narudžbinu" Command="{Binding PotvrdiCommand}"/>
        </StackPanel>
    </Grid>
</UserControl>
