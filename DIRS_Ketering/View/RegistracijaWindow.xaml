<Window x:Class="DIRS_Ketering.View.RegistracijaWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DIRS_Ketering.View"
        mc:Ignorable="d"
        Title="RegistracijaWindow" Height="450" Width="800">
    <Grid>

        <StackPanel Margin="20">
            <TextBlock Text="Email"/>
            <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10"/>

            <TextBlock Text="Ime"/>
            <TextBox Text="{Binding Ime, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10"/>

            <TextBlock Text="Lozinka"/>
            <PasswordBox x:Name="PbLozinka" Margin="0,0,0,10"/>

            <TextBlock Text="{Binding Greska}" Foreground="Red" Margin="0,0,0,10"/>
            
            <Button Content="Registruj se" Command="{Binding RegistrujCommand}"/>
        </StackPanel>
    </Grid>
</Window>
