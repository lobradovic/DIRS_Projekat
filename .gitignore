## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.

# User-specific files
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates

# Build results
[Bb]in/
[Oo]bj/
x64/
x86/
Debug/
Release/

# Visual Studio cache/options
.vs/

# Rider
.idea/

# VS Code
.vscode/

# NuGet
*.nupkg
packages/
!packages/build/
*.snupkg

# Logs
*.log

# OS generated files
.DS_Store
Thumbs.db

# WPF specific
*.g.cs
*.g.i.cs
*.baml

# Publish output
publish/

# Test results
TestResults/

# Resharper
_ReSharper*/
*.DotSettings.user

# DotCover
*.dotCover

# Azure DevOps
*.coverage
*.coveragexml

# SQL Server LocalDB
*.mdf
*.ldf

# SQLite
*.sqlite
*.db

# Temporary files
*.tmp
*.temp

# JetBrains Rider
*.sln.iml

# Generated files
Generated\ Files/

# Backup files
Backup*/
*.bak

# ClickOnce
app.publish/

# Windows Installer packages
*.msi
*.msix
*.appx
*.appxbundle

# Certificates
*.pfx

# Environment files
.env
.env.*

# Secrets
secrets.json
appsettings.Development.json